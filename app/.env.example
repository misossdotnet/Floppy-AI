COMPOSE_PROJECT_NAME=floppy-aidataswarehouse
APP_ENV=development
APP_ENABLE_UI=true
APP_ENABLE_API=true
APP_ENABLE_MCP=true
POSTGRES_DB=dataswarehouse
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_AUTO_CREATE_DB=false
POSTGRES_VOLUME_NAME=floppy-aidataswarehouse_postgres_data
POSTGRES_VOLUME_NAME_DEV=floppy-aidataswarehouse_postgres_data_dev
FLASK_SECRET_KEY=change-this-secret
FLOPPY_REQUIRE_AUTH=false
FLOPPY_AUTH_TOKENS=dev-token:admin
FLOPPY_API_USERS={"api-admin":{"password":"change-me","scopes":["admin"]}}
FLOPPY_JWT_SECRET=change-this-jwt-secret
FLOPPY_JWT_ACCESS_TTL=900
FLOPPY_JWT_REFRESH_TTL=604800
FLOPPY_ADMIN_USERNAME=admin
FLOPPY_ADMIN_PASSWORD=admin
FLOPPY_UI_USERS={"admin":{"password":"admin","role":"admin"},"editor":{"password":"editor","role":"editor"},"viewer":{"password":"viewer","role":"viewer"}}
FLOPPY_RATE_LIMIT_ENABLED=true
FLOPPY_RATE_LIMIT_API=120
FLOPPY_RATE_LIMIT_MCP=120
FLOPPY_RATE_LIMIT_PUBLIC=30
FLOPPY_TRUST_PROXY_HEADERS=false
FLOPPY_CORS_ORIGINS=http://localhost:8000
ASGI_WSGI_THREADPOOL_WORKERS=8
LLM_PROVIDER=ollama
LLM_API_URL=http://ollama:11434/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=90
LLM_MAX_TOKENS=800
LLM_RETRIES=1
LLM_JSON_MODE=false
UVICORN_TIMEOUT_KEEP_ALIVE=360
UVICORN_TIMEOUT_GRACEFUL_SHUTDOWN=360
AGENTAI_LLM_PROVIDER=
AGENTAI_LLM_API_URL=
AGENTAI_LLM_API_KEY=
AGENTAI_LLM_MODEL=
AGENTAI_LLM_TIMEOUT=90
AGENTAI_LLM_MAX_TOKENS=800
AGENTAI_LLM_RETRIES=1
AGENTAI_LLM_JSON_MODE=false
VECTOR_ENABLED=false
VECTOR_LLM_CONFIG_ID=
VECTOR_EMBEDDING_API_URL=
VECTOR_EMBEDDING_MODEL=
VECTOR_EMBEDDING_DIMENSIONS=1536
VECTOR_BATCH_SIZE=25
QUIZBOT_LLM_PROVIDER=ollama
QUIZBOT_LLM_API_URL=http://localhost:11434/v1/chat/completions
QUIZBOT_LLM_API_KEY=
QUIZBOT_QUESTION_MODEL=
QUIZBOT_CORRECTION_MODEL=
